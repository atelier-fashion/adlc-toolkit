#!/usr/bin/env python3
"""adlc-write — ask the configured delegate to generate a file from a spec.

Generates a complete file from a spec string plus an optional reference file and
writes it to a target path, for Claude to review. Refuses to clobber an existing
target without --force, and never creates parent directories. The provider is
resolved by ``_common.resolve_provider``.
"""

import argparse
import os
import sys

# `realpath`, not `abspath`: this must resolve to the directory of the REAL
# file (the ~/bin wrapper symlinks these CLIs), matching `_common._repo_root`.
# `abspath` would keep the symlink's own directory on the path, where a
# `_common.py` planted next to the symlink would shadow the toolkit's.
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

import _common  # noqa: E402

_SYSTEM_PROMPT = (
    "You generate complete, idiomatic files matching the given conventions. "
    "Output ONLY the file contents — no markdown code fences, no commentary."
)


def _build_parser():
    parser = argparse.ArgumentParser(
        prog="adlc-write",
        # No prefix abbreviation. The pre-parse argv scans (`wants_version`,
        # `harvest_provider_flags`) match option names by EXACT spelling, and
        # their exact-spelling sets are only provably complete if argparse also
        # refuses abbreviations: with them enabled, `--sp "--version"` is a valid
        # spelling of `--spec` that no fixed set can enumerate, so the scan sees
        # `--version` in flag position and prints the version instead.
        allow_abbrev=False,
        description="Generate a file from a spec with the configured delegate.",
        epilog="--version, -V: print the toolkit version and the resolved delegate "
               "config (base_url, model, api_key_env NAME, enabled) and exit; "
               "handled before parsing, so --spec/--target are not required.",
    )
    parser.add_argument("--spec", required=True, help="description of what to generate")
    parser.add_argument("--context", default=None, help="reference file for patterns/conventions")
    parser.add_argument("--target", required=True, help="output file path")
    parser.add_argument("--force", action="store_true", help="allow overwriting an existing --target")
    # Declared so it appears in --help and in the parser-vs-_KNOWN_FLAGS mirror
    # test, even though the pre-argparse scan in main() is what actually handles
    # it (--spec/--target are required=True, so argparse would exit 2 first).
    parser.add_argument(
        "--print-gate",
        action="store_true",
        help="print '<enabled> <reason>' and exit — the gate's full verdict "
             "(REQ-603); no spec or target required, no network call",
    )
    parser.add_argument(
        "--max-tokens", type=int, default=_common.DEFAULT_MAX_TOKENS,
        help="completion budget; on reasoning models this covers reasoning AND output "
             f"together (default {_common.DEFAULT_MAX_TOKENS}, shared by both CLIs — BUG-213). "
             "A run that hits it fails loudly rather than returning a truncated answer.",
    )
    parser.add_argument("--model", default=None, help="override the resolved model")
    parser.add_argument("--base-url", default=None, help="override the resolved base URL")
    parser.add_argument(
        "--no-warn",
        action="store_true",
        help="suppress the data-exfiltration notice",
    )
    return parser


def _parse_args(argv=None):
    return _build_parser().parse_args(argv)


# Options whose VALUE could be the literal string `--version`/`-V` — a spec
# string is free-form text, so `--spec --version` must not print the version.
# argparse rejects that separated form outright ("expected one argument": a
# dash-prefixed token is never taken as a value), so the run it must not
# short-circuit is argparse's own exit-2; only the attached `--spec=--version`
# form parses and goes on to generate a file. Either way the pre-parse scan has
# to know which tokens consume the token after them.
# The SAME set goes to both pre-parse scans — `wants_version` and
# `harvest_provider_flags` walk the same argv and must agree on where the
# value positions are, or one of them reads a value as a flag.
# Complete by exact spelling only because the parser sets `allow_abbrev=False`.
_VERSION_VALUE_FLAGS = frozenset({
    "--spec", "--context", "--target", "--max-tokens", "--model", "--base-url",
})

# EVERY option spelling `_build_parser()` declares, `--version`/`-V` aside (they
# never reach argparse). An option token outside this set means the argv is one
# argparse will reject, so the pre-parse scan declines and lets it do that rather
# than printing the version for a command the user did not write — the `--sp
# "--version"` hijack. Kept honest by a test that derives the same set from the
# parser itself.
_KNOWN_FLAGS = _VERSION_VALUE_FLAGS | frozenset({
    "-h", "--help", "--force", "--print-gate", "--no-warn",
})


def main(argv=None):
    # --version/-V: scanned out of argv BEFORE argparse — required for this CLI,
    # since --spec/--target are required=True and argparse would exit 2 first
    # (ADR-1). Runs before every guard and never touches the network. Reports the
    # config the REAL call would resolve — same resolver, not a re-implementation
    # (BR-3, LESSON-392), including this invocation's --model/--base-url
    # overrides. The key VALUE is never read or printed; only the env-var NAME
    # (BR-2). A refused config degrades to one `config_error:` line, exit 0
    # (BR-6) — see `_common.version_report_lines`, the sole BR-9 implementation.
    if _common.wants_version(argv, _VERSION_VALUE_FLAGS, _KNOWN_FLAGS):
        m, b = _common.harvest_provider_flags(argv, _VERSION_VALUE_FLAGS)
        print("\n".join(_common.version_report_lines(args_model=m, args_base_url=b)))
        return 0

    # --print-gate: scanned out of argv BEFORE argparse for the same reason
    # --version is (ADR-1) — --spec/--target are required=True and argparse would
    # exit 2 first. Uses the SAME value-aware scanner, not a membership test: a
    # bare `"--print-gate" in argv` also matched VALUE positions, so
    # `adlc-write --spec "--print-gate" --target out` printed the verdict and
    # exited 0 instead of reaching argparse's error. That is the documented
    # `--sp "--version"` hijack class this machinery exists to close. Reports the gate's verdict and exits 0 on EVERY path,
    # including disabled: it REPORTS, it never refuses (REQ-603 BR-10). Routing
    # it through require_delegation_enabled() would make a caller read a non-zero
    # exit and mislabel a `disabled-via-env` machine as `not-opted-in`.
    if _common.wants_flag(argv, ("--print-gate",), _VERSION_VALUE_FLAGS, _KNOWN_FLAGS):
        enabled, reason = _common.resolve_gate_verdict()
        print(f"{1 if enabled else 0} {reason}")
        return 0

    args = _parse_args(argv)

    if os.path.exists(args.target) and not args.force:
        sys.exit(f"target already exists (use --force to overwrite): {args.target}")

    parent = os.path.dirname(os.path.abspath(args.target))
    if not os.path.isdir(parent):
        sys.exit(f"parent directory does not exist: {parent}")

    reference_block = None
    if args.context is not None:
        if not os.path.isfile(args.context) or not os.access(args.context, os.R_OK):
            sys.exit(f"not a readable file: {args.context}")
        with open(args.context, "r", encoding="utf-8") as fh:
            content = fh.read()
        # Only the basename leaves the local machine. Full path stays in local
        # SystemExit error messages for actionability (privacy posture, LESSON-007).
        reference_block = f"<reference path='{os.path.basename(args.context)}'>\n{content}\n</reference>"

    messages = [{"role": "system", "content": _SYSTEM_PROMPT}]
    if reference_block is not None:
        messages.append({"role": "user", "content": reference_block})
    messages.append({"role": "user", "content": args.spec})

    # Refuse to transmit unless delegation is actually opted in (BUG-206).
    # After the local guards above (a clobber or bad path is the user's typo and
    # should be reported as such) and before provider resolution, so a disabled
    # setup reports "disabled" rather than a confusing config/key error.
    _common.require_delegation_enabled("adlc-write")

    # Resolve the provider once (validates key-in-config refusal before any
    # network touch). Notice fires after all local guards (clobber, missing
    # parent dir, unreadable context) but BEFORE get_client(), so the user always
    # sees the privacy notice for any run that has reached the would-call-the-API
    # stage.
    provider = _common.resolve_provider(args_model=args.model, args_base_url=args.base_url)
    if not args.no_warn and not _common.warn_suppressed():
        _common.emit_exfil_notice(provider=provider)
    client = _common.get_client(provider)
    result = _common._strip_fences(_common.complete(client, provider.model, messages, args.max_tokens))

    with open(args.target, "w", encoding="utf-8") as fh:
        fh.write(result)

    print(f"wrote: {args.target}")
    print("Review this generated file before using it — delegate output is not vetted.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
