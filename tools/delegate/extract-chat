#!/usr/bin/env python3
"""extract-chat — clean a Claude Code session JSONL transcript into readable text.

Emits only human prompts and assistant natural-language replies, stripping tool
calls, tool results, system prompts, and binary/base64 blobs. Pure local
transformation — no API call, no MOONSHOT_API_KEY needed.
"""
import argparse
import json
import re
import sys


# Minimum length at which a string composed entirely of base64-alphabet
# characters (RFC 4648 alphabet — no whitespace) is treated as a raw base64
# blob and filtered. A string with embedded whitespace is treated as prose and
# passes through, even at higher lengths, to avoid eating ordinary text that
# happens to contain only letters and spaces.
_RAW_BASE64_MIN_LEN = 512

_BASE64_RE = re.compile(r"[A-Za-z0-9+/=]+")


def _looks_binary(text):
    if not isinstance(text, str):
        return False
    stripped = text.strip()
    if stripped.startswith("data:"):
        return True
    if len(stripped) >= _RAW_BASE64_MIN_LEN and _BASE64_RE.fullmatch(stripped):
        return True
    return False


def _extract_text_from_content(content, drop_block_types):
    """Return concatenated human-readable text from a message `content` value.

    `content` may be a plain string or a list of content blocks (dicts or
    strings). Blocks whose `type` is in `drop_block_types` are skipped, as are
    blocks that look like images / base64 / data URIs.
    """
    if isinstance(content, str):
        if _looks_binary(content):
            return ""
        return content.strip()

    if not isinstance(content, list):
        return ""

    parts = []
    for block in content:
        if isinstance(block, str):
            if _looks_binary(block):
                continue
            block = block.strip()
            if block:
                parts.append(block)
            continue
        if not isinstance(block, dict):
            continue
        btype = block.get("type")
        if btype in drop_block_types:
            continue
        if btype == "image":
            continue
        if btype == "text" or btype is None:
            txt = block.get("text")
            if isinstance(txt, str) and not _looks_binary(txt):
                txt = txt.strip()
                if txt:
                    parts.append(txt)
    return "\n\n".join(parts).strip()


def _iter_turns(fh):
    """Yield (role, text) tuples for recognized conversation turns."""
    for line in fh:
        line = line.strip()
        if not line:
            continue
        try:
            record = json.loads(line)
        except (ValueError, TypeError):
            continue
        if not isinstance(record, dict):
            continue
        message = record.get("message")
        if not isinstance(message, dict):
            continue
        role = message.get("role")
        if role not in ("user", "assistant"):
            continue
        content = message.get("content")
        if role == "assistant":
            drop = {"tool_use"}
        else:  # user
            drop = {"tool_result"}
        text = _extract_text_from_content(content, drop)
        if not text:
            continue
        yield role, text


def _build_parser():
    parser = argparse.ArgumentParser(
        # No prefix abbreviation. The pre-parse argv scan (`wants_version`)
        # matches option names by EXACT spelling, and its exact-spelling set is
        # only provably complete if argparse also refuses abbreviations: with
        # them enabled, `--out "-V"` is a valid spelling of `--output` that no
        # fixed set can enumerate, so the scan would see `-V` in flag position
        # and print the version instead of writing the file.
        allow_abbrev=False,
        description="Clean a Claude Code session JSONL transcript into readable text.",
        epilog="--version, -V: print the toolkit version and exit; handled before "
               "parsing, so no transcript path is required.")
    parser.add_argument("jsonl_path", help="path to the .jsonl session transcript")
    parser.add_argument("-o", "--output", metavar="PATH",
                        help="write output here instead of stdout")
    return parser


# Options whose VALUE could be the literal `--version`/`-V` (`-o -V` names an
# output FILE), and every option spelling the parser declares. See
# `_common.wants_version`: an option token outside `_KNOWN_FLAGS` is one
# argparse will reject, so the scan declines rather than printing the version
# for a command the user did not write. Complete by exact spelling only because
# the parser sets `allow_abbrev=False`; kept honest by a test that derives the
# same set from the parser itself.
_VERSION_VALUE_FLAGS = frozenset({"-o", "--output"})
_KNOWN_FLAGS = _VERSION_VALUE_FLAGS | frozenset({"-h", "--help"})


def main(argv=None):
    # --version/-V: scanned out of argv BEFORE argparse (ADR-1), which would
    # otherwise exit 2 on the missing required positional. `_common` is imported
    # INSIDE this branch so extract-chat's module-load surface stays as it is —
    # the local transform path pulls in nothing from the delegation layer
    # (ADR-2). The cheap membership test below is only a PRE-FILTER that decides
    # whether the import is worth doing; `_common.wants_version` is the
    # authoritative, value-aware answer (`-o -V` names an output file, it does
    # not ask for the version), and a False there falls through to normal
    # parsing. Version line only: this CLI has no delegate config.
    effective = argv if argv is not None else sys.argv[1:]
    if "--version" in effective or "-V" in effective:
        import os
        # `realpath`, not `abspath`: resolve to the REAL file's directory (the
        # ~/bin wrapper symlinks this CLI), matching `_common._repo_root`. With
        # `abspath` a `_common.py` planted beside the symlink would shadow the
        # toolkit's.
        sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
        import _common
        if _common.wants_version(argv, _VERSION_VALUE_FLAGS, _KNOWN_FLAGS):
            print(_common.version_report_lines(include_config=False)[0])
            return 0

    args = _build_parser().parse_args(argv)

    try:
        fh = open(args.jsonl_path, "r", encoding="utf-8", errors="replace")
    except OSError as exc:
        print("extract-chat: cannot open %s: %s" % (args.jsonl_path, exc),
              file=sys.stderr)
        return 1

    chunks = []
    with fh:
        for role, text in _iter_turns(fh):
            header = "## Human" if role == "user" else "## Assistant"
            chunks.append("%s\n%s" % (header, text))

    output = "\n\n".join(chunks)
    if chunks:
        output += "\n"

    if args.output:
        try:
            with open(args.output, "w", encoding="utf-8") as out:
                out.write(output)
        except OSError as exc:
            print("extract-chat: cannot write %s: %s" % (args.output, exc),
                  file=sys.stderr)
            return 1
    else:
        sys.stdout.write(output)

    return 0


if __name__ == "__main__":
    sys.exit(main())
