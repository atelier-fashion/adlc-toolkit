# Claude Code worktrees (created by /proceed for parallel session isolation)
.claude/worktrees/
.worktrees/

# Per-user Claude Code overrides (team settings live in .claude/settings.json)
.claude/settings.local.json

# OS noise
.DS_Store

# ADLC pipeline state (ephemeral, per-worktree)
.adlc/specs/*/pipeline-state.json

# ADLC session sidecars (per-session transcript pointers written by a hook, per-worktree)
.adlc/.session/

# macOS Finder / iCloud duplicate suffix pattern (e.g. "CLAUDE 2.md", "Dockerfile 2")
* [0-9].*
* [0-9]

# pytest cache (a stale one has tripped the brand scan)
.pytest_cache/

# Python bytecode (a tracked .pyc slipped into a REQ-664 commit)
__pycache__/
*.pyc
